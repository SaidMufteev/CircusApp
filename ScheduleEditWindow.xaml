<Window x:Class="CircusApp.ScheduleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Расписание гастролей" Height="350" Width="450"
        WindowStartupLocation="CenterScreen"
        FontFamily="Tw Cen MT">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Представление:*" VerticalAlignment="Center" Margin="0,10"/>
        <!-- Отображаем Название представления -->
        <ComboBox Grid.Row="0" Grid.Column="1" Name="ShowCB" Margin="0,10" DisplayMemberPath="Название"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Место проведения:*" VerticalAlignment="Center" Margin="0,10"/>
        <!-- ВНИМАНИЕ: Если в таблице Места_Гастролей поле называется не "Название", а например "Город", замени DisplayMemberPath="Название" на нужное -->
        <ComboBox Grid.Row="1" Grid.Column="1" Name="PlaceCB" Margin="0,10" DisplayMemberPath="Название"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Дата начала:*" VerticalAlignment="Center" Margin="0,10"/>
        <DatePicker Grid.Row="2" Grid.Column="1" Name="StartDateDP" Margin="0,10" VerticalAlignment="Center"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Дата окончания:*" VerticalAlignment="Center" Margin="0,10"/>
        <DatePicker Grid.Row="3" Grid.Column="1" Name="EndDateDP" Margin="0,10" VerticalAlignment="Center"/>

        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,20,0,0">
            <Button Content="Сохранить" Width="120" Height="35" Margin="10" Click="SaveBtn_Click"/>
            <Button Content="Отмена" Width="120" Height="35" Margin="10" Click="CancelBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>