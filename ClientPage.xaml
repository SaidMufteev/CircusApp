<Page x:Class="CircusApp.ClientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Клиент" FontFamily="Tw Cen MT"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Выйти" Width="120" Height="35" Margin="10,0,0,0" Click="Logout_Click"/>
            <TextBlock Text="Личный кабинет" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
        </DockPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Афиша">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" Name="ShowsGrid" AutoGenerateColumns="True" IsReadOnly="True" SelectionChanged="ShowsGrid_SelectionChanged"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Сеанс:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Name="SessionCB" Width="250" DisplayMemberPath="Дата_начала"/>

                        <TextBlock Text="Билетов:" VerticalAlignment="Center" Margin="15,0,6,0"/>
                        <TextBox Name="TicketsTB" Width="50" TextChanged="TicketsTB_TextChanged"/>

                        <TextBlock Text="Цена за 1:" VerticalAlignment="Center" Margin="15,0,6,0"/>
                        <TextBox Name="PriceTB" Width="60" Text="1000"/>
                    </StackPanel>

                    <Button Grid.Row="2" Content="Купить билеты" Width="180" Height="40" HorizontalAlignment="Left" Margin="0,10,0,0" Click="BuyBtn_Click"/>
                </Grid>
            </TabItem>

            <TabItem Header="Мои заказы">
                <DataGrid Margin="10" Name="MyOrdersGrid" AutoGenerateColumns="True" IsReadOnly="True"/>
            </TabItem>

            <TabItem Header="Профиль">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Фамилия:" Margin="0,6"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" Name="LastNameTB" Width="300" HorizontalAlignment="Left" Margin="0,6"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Имя:" Margin="0,6"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" Name="FirstNameTB" Width="300" HorizontalAlignment="Left" Margin="0,6"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Отчество:" Margin="0,6"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" Name="MiddleNameTB" Width="300" HorizontalAlignment="Left" Margin="0,6"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Телефон:" Margin="0,6"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" Name="PhoneTB" Width="300" HorizontalAlignment="Left" Margin="0,6"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Email:" Margin="0,6"/>
                    <TextBox   Grid.Row="4" Grid.Column="1" Name="EmailTB" Width="300" HorizontalAlignment="Left" Margin="0,6"/>

                    <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Content="Сохранить" Width="180" Height="40" HorizontalAlignment="Left" Margin="0,15,0,0" Click="SaveProfileBtn_Click"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>