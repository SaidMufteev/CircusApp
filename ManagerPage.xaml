<Page x:Class="CircusApp.ManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Менеджер" FontFamily="Tw Cen MT"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Выйти"
                    Width="120" Height="35" Margin="10,0,0,0"
                    Click="Logout_Click"/>
            <TextBlock Text="Панель менеджера"
                       FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <TabControl Grid.Row="1">

            <TabItem Header="Представления">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Добавить" Width="110" Height="32" Margin="0,0,8,0"
                                Click="AddShowBtn_Click"/>
                        <Button Content="Редактировать" Width="120" Height="32" Margin="0,0,8,0"
                                Click="EditShowBtn_Click"/>
                        <Button Content="Удалить" Width="110" Height="32"
                                Click="DeleteShowBtn_Click"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" Name="ShowsGrid"
                              AutoGenerateColumns="True" IsReadOnly="True"/>
                </Grid>
            </TabItem>

            <TabItem Header="Гастроли / расписание">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Добавить" Width="110" Height="32" Margin="0,0,8,0"
                                Click="AddTourBtn_Click"/>
                        <Button Content="Редактировать" Width="120" Height="32"
                                Click="EditTourBtn_Click"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" Name="ToursGrid"
                              AutoGenerateColumns="True" IsReadOnly="True"/>
                </Grid>
            </TabItem>

            <TabItem Header="Работники (просмотр)">
                <DataGrid Margin="10" Name="WorkersGrid"
                          AutoGenerateColumns="True" IsReadOnly="True"/>
            </TabItem>

            <TabItem Header="Заказы (просмотр)">
                <DataGrid Margin="10" Name="OrdersGrid"
                          AutoGenerateColumns="True" IsReadOnly="True"/>
            </TabItem>

            <TabItem Header="Аналитика">
                <StackPanel Margin="20">
                    <TextBlock Text="Сводка по продажам"
                               FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Name="TotalOrdersTB" Text="Заказов: —" FontSize="14" Margin="0,0,0,6"/>
                    <TextBlock Name="TotalRevenueTB" Text="Выручка: —" FontSize="14" Margin="0,0,0,6"/>
                    <TextBlock Name="TotalClientsTB" Text="Клиентов: —" FontSize="14" Margin="0,0,0,6"/>
                    <TextBlock Name="TotalShowsTB" Text="Представлений: —" FontSize="14"/>
                </StackPanel>
            </TabItem>

        </TabControl>
    </Grid>
</Page>