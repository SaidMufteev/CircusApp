<Page x:Class="CircusApp.AddEditShowPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Добавление/редактирование представления" FontFamily="Tw Cen MT"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Название:" Grid.Row="0" Grid.Column="0" FontSize="16" VerticalAlignment="Center" Margin="5,10,5,10"/>
        <TextBox Name="TbName" Grid.Row="0" Grid.Column="1" FontSize="16" Margin="5,10,5,10" Height="30" Text="{Binding Название}"/>

        <TextBlock Text="Жанр:" Grid.Row="1" Grid.Column="0" FontSize="16" VerticalAlignment="Center" Margin="5,10,5,10"/>
        <TextBox Name="TbGenre" Grid.Row="1" Grid.Column="1" FontSize="16" Margin="5,10,5,10" Height="30" Text="{Binding Жанр}"/>

        <TextBlock Text="Тип:" Grid.Row="2" Grid.Column="0" FontSize="16" VerticalAlignment="Center" Margin="5,10,5,10"/>
        <TextBox Name="TbType" Grid.Row="2" Grid.Column="1" FontSize="16" Margin="5,10,5,10" Height="30" Text="{Binding Тип}"/>

        <TextBlock Text="Автор:" Grid.Row="3" Grid.Column="0" FontSize="16" VerticalAlignment="Center" Margin="5,10,5,10"/>
        <TextBox Name="TbAuthor" Grid.Row="3" Grid.Column="1" FontSize="16" Margin="5,10,5,10" Height="30" Text="{Binding Автор}"/>

        <TextBlock Text="Изображение:" Grid.Row="4" Grid.Column="0" FontSize="16" VerticalAlignment="Center" Margin="5,10,5,10"/>
        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="5,10,5,10">
            <Image Name="ImgPreview" Width="80" Height="80" Stretch="UniformToFill" 
                   Source="res/image/picture.png" Margin="0,0,10,0"/>
            <Button Content="Выбрать фото" Width="150" Height="30" Click="SelectImage_Click"/>
            <Button Content="Очистить" Width="100" Height="30" Margin="10,0,0,0" Click="ClearImage_Click"/>
        </StackPanel>

        <Button Content="Сохранить" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" 
                Width="200" Height="40" Margin="10" Click="SaveButton_Click" HorizontalAlignment="Center"/>

        <Button Content="Назад" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" 
                Width="200" Height="40" Margin="10" Click="BackButton_Click" HorizontalAlignment="Center"/>
    </Grid>
</Page>