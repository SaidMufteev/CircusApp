<Application x:Class="CircusApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Кисти -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#FFF5E6"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#C62828"/>
        <SolidColorBrush x:Key="GoldBrush" Color="#FFB300"/>
        <SolidColorBrush x:Key="TextBrush" Color="#2E2E2E"/>

        <!-- Стиль для кнопок (как в методичке) -->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Width" Value="175"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontFamily" Value="Tw Cen MT"/>
            <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
    </Application.Resources>
</Application>