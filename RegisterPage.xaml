<Page x:Class="CircusApp.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация" FontFamily="Tw Cen MT"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Фамилия:" Grid.Row="0" Grid.Column="0"
                   FontSize="16" VerticalAlignment="Center" Margin="10"/>
        <TextBox Name="TbLastName" Grid.Row="0" Grid.Column="1"
                 FontSize="16" Margin="10" Width="300" HorizontalAlignment="Left"/>

        <TextBlock Text="Имя:" Grid.Row="1" Grid.Column="0"
                   FontSize="16" VerticalAlignment="Center" Margin="10"/>
        <TextBox Name="TbFirstName" Grid.Row="1" Grid.Column="1"
                 FontSize="16" Margin="10" Width="300" HorizontalAlignment="Left"/>

        <TextBlock Text="Отчество:" Grid.Row="2" Grid.Column="0"
                   FontSize="16" VerticalAlignment="Center" Margin="10"/>
        <TextBox Name="TbMiddleName" Grid.Row="2" Grid.Column="1"
                 FontSize="16" Margin="10" Width="300" HorizontalAlignment="Left"/>

        <TextBlock Text="Телефон:" Grid.Row="3" Grid.Column="0"
                   FontSize="16" VerticalAlignment="Center" Margin="10"/>
        <TextBox Name="TbPhone" Grid.Row="3" Grid.Column="1"
                 FontSize="16" Margin="10" Width="300" HorizontalAlignment="Left"/>

        <TextBlock Text="Email:" Grid.Row="4" Grid.Column="0"
                   FontSize="16" VerticalAlignment="Center" Margin="10"/>
        <TextBox Name="TbEmail" Grid.Row="4" Grid.Column="1"
                 FontSize="16" Margin="10" Width="300" HorizontalAlignment="Left"/>

        <TextBlock Text="Логин:" Grid.Row="5" Grid.Column="0"
                   FontSize="16" VerticalAlignment="Center" Margin="10"/>
        <TextBox Name="TbLogin" Grid.Row="5" Grid.Column="1"
                 FontSize="16" Margin="10" Width="300" HorizontalAlignment="Left"/>

        <TextBlock Text="Пароль:" Grid.Row="6" Grid.Column="0"
                   FontSize="16" VerticalAlignment="Center" Margin="10"/>
        <PasswordBox Name="PbPassword" Grid.Row="6" Grid.Column="1"
                     FontSize="16" Margin="10" Width="300" HorizontalAlignment="Left"/>

        <Button Content="Зарегистрироваться" Grid.Row="7" Grid.Column="0"
                Grid.ColumnSpan="2" Width="200" Height="40" Margin="10"
                Click="RegisterBtn_Click" HorizontalAlignment="Center"/>

        <Button Content="Назад" Grid.Row="8" Grid.Column="0"
                Grid.ColumnSpan="2" Width="200" Height="40" Margin="10"
                Click="BackBtn_Click" HorizontalAlignment="Center"/>
    </Grid>
</Page>