<Page x:Class="CircusApp.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Оформление заказа" FontFamily="Tw Cen MT"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Название представления -->
        <TextBlock Text="Представление:" Grid.Row="0" Grid.Column="0" FontSize="16" VerticalAlignment="Center" Margin="5,10"/>
        <TextBlock Name="TbShowName" Grid.Row="0" Grid.Column="1" FontSize="18" FontWeight="Bold" 
                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="5,10"/>

        <!-- Выбор сеанса -->
        <TextBlock Text="Сеанс (дата, время, цена):" Grid.Row="1" Grid.Column="0" FontSize="16" VerticalAlignment="Center" Margin="5,10"/>
        <ComboBox Name="ComboSession" Grid.Row="1" Grid.Column="1" FontSize="14" Width="350" 
                  HorizontalAlignment="Left" Margin="5,10" SelectionChanged="ComboSession_SelectionChanged"/>

        <!-- Выбор клиента -->
        <TextBlock Text="Клиент:" Grid.Row="2" Grid.Column="0" FontSize="16" VerticalAlignment="Center" Margin="5,10"/>
        <ComboBox Name="ComboClient" Grid.Row="2" Grid.Column="1" FontSize="14" Width="350" 
                  HorizontalAlignment="Left" Margin="5,10"/>

        <!-- Количество билетов -->
        <TextBlock Text="Количество билетов:" Grid.Row="3" Grid.Column="0" FontSize="16" VerticalAlignment="Center" Margin="5,10"/>
        <TextBox Name="TbQuantity" Grid.Row="3" Grid.Column="1" FontSize="14" Width="100" 
                 HorizontalAlignment="Left" Margin="5,10" TextChanged="TbQuantity_TextChanged"/>

        <!-- Сумма -->
        <TextBlock Text="Сумма:" Grid.Row="4" Grid.Column="0" FontSize="16" VerticalAlignment="Center" Margin="5,10"/>
        <TextBlock Name="TbTotal" Grid.Row="4" Grid.Column="1" FontSize="18" FontWeight="Bold" 
                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="5,10"/>

        <!-- Кнопка Сохранить -->
        <Button Name="SaveButton" Content="Оформить заказ" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" 
                Width="200" Height="40" Margin="10" Click="SaveButton_Click" HorizontalAlignment="Center"/>

        <!-- Кнопка Назад -->
        <Button Content="Назад" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" 
                Width="200" Height="40" Margin="10" Click="BackButton_Click" HorizontalAlignment="Center"/>
    </Grid>
</Page>