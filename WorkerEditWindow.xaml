<Window x:Class="CircusApp.WorkerEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Работник" Height="550" Width="450"
        WindowStartupLocation="CenterScreen"
        FontFamily="Tw Cen MT">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ФИО -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Фамилия:*" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox Grid.Row="0" Grid.Column="1" Name="LastNameTB" Margin="0,5"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Имя:*" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox Grid.Row="1" Grid.Column="1" Name="FirstNameTB" Margin="0,5"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Отчество:" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox Grid.Row="2" Grid.Column="1" Name="MiddleNameTB" Margin="0,5"/>

            <!-- Даты и стаж -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Год рождения:*" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox Grid.Row="3" Grid.Column="1" Name="BirthYearTB" Margin="0,5" Text="1990"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Год поступления:*" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox Grid.Row="4" Grid.Column="1" Name="HireYearTB" Margin="0,5" Text="2023"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Стаж (лет):" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox Grid.Row="5" Grid.Column="1" Name="ExperienceTB" Margin="0,5" Text="0"/>

            <!-- Должность и пол -->
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Должность:" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox Grid.Row="6" Grid.Column="1" Name="PositionTB" Margin="0,5" Text="Артист"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Пол (М/Ж):" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox Grid.Row="7" Grid.Column="1" Name="GenderTB" Margin="0,5" MaxLength="1" Text="М"/>

            <!-- Контакты -->
            <TextBlock Grid.Row="8" Grid.Column="0" Text="Телефон:" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox Grid.Row="8" Grid.Column="1" Name="PhoneTB" Margin="0,5"/>

            <TextBlock Grid.Row="9" Grid.Column="0" Text="Город:" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox Grid.Row="9" Grid.Column="1" Name="CityTB" Margin="0,5"/>

            <TextBlock Grid.Row="10" Grid.Column="0" Text="Адрес:" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox Grid.Row="10" Grid.Column="1" Name="AddressTB" Margin="0,5"/>

            <!-- Кнопки -->
            <StackPanel Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,20,0,0">
                <Button Content="Сохранить" Width="120" Height="35" Margin="10" Click="SaveBtn_Click"/>
                <Button Content="Отмена" Width="120" Height="35" Margin="10" Click="CancelBtn_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>