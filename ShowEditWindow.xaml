<Window x:Class="CircusApp.ShowEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Представление" Height="400" Width="400"
        WindowStartupLocation="CenterScreen"
        FontFamily="Tw Cen MT">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Название:*" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox Grid.Row="0" Grid.Column="1" Name="NameTB" Margin="0,5"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Автор:" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox Grid.Row="1" Grid.Column="1" Name="AuthorTB" Margin="0,5"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Жанр:" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox Grid.Row="2" Grid.Column="1" Name="GenreTB" Margin="0,5"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Тип:" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox Grid.Row="3" Grid.Column="1" Name="TypeTB" Margin="0,5"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Путь к фото:" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox Grid.Row="4" Grid.Column="1" Name="ImageTB" Margin="0,5"/>

        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,15,0,0">
            <Button Content="Сохранить" Width="120" Height="35" Margin="10" Click="SaveBtn_Click"/>
            <Button Content="Отмена" Width="120" Height="35" Margin="10" Click="CancelBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>